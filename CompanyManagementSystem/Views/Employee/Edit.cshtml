@model CompanyManagementMVC.BLL.ModelVM.Employee.UpdateEmployeeVM
@{
    ViewData["Title"] = "Edit Employee";
}

<style>
    .form-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .form-header {
        background: linear-gradient(135deg, #f59f00 0%, #f76707 100%);
        color: white;
        padding: 2rem;
        text-align: center;
    }

        .form-header h3 {
            margin: 0;
            font-weight: 700;
        }

    .form-body {
        padding: 2.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        transition: all 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #f59f00;
            box-shadow: 0 0 0 0.2rem rgba(245,159,0,0.15);
        }

    .input-group-text {
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-right: none;
        border-radius: 12px 0 0 12px;
        color: #f59f00;
        font-weight: 700;
    }

    .btn-submit {
        background: linear-gradient(135deg, #f59f00 0%, #f76707 100%);
        color: white;
        border: none;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(245,159,0,0.3);
            color: white;
        }

    .btn-cancel {
        background: #f8f9fa;
        color: #495057;
        border: 2px solid #e9ecef;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
    }

        .btn-cancel:hover {
            background: #e9ecef;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="form-card">
                <div class="form-header">
                    <i class="bi bi-pencil-square fs-1 mb-2 d-block"></i>
                    <h3>Edit Employee</h3>
                </div>
                <div class="form-body">
                    <form asp-action="Edit" asp-controller="Employee" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="All" class="alert alert-danger rounded-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"><i class="bi bi-person me-1"></i>Full Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Salary" class="form-label"><i class="bi bi-cash me-1"></i>Salary</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Salary" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Salary" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DepartmentId" class="form-label"><i class="bi bi-building me-1"></i>Department</label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                                <option value="">-- Select Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-submit flex-fill">
                                <i class="bi bi-check-lg me-2"></i>Update Employee
                            </button>
                            <a asp-action="GetAll" class="btn btn-cancel">
                                <i class="bi bi-x-lg me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}